---
import { LINKS } from '../data/links.js';
---
  <!-- ================= 8. FOOTER ================= -->
  <footer class="bg-carbon-950 border-t border-carbon-800 py-8 text-xs font-mono text-slate-400">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2.5">
        <img src="./aset/logo.png" width="32" height="32" alt="Logo TJ FACTORY" loading="lazy" decoding="async"
          class="w-8 h-8 object-contain border border-carbon-700 p-1 bg-carbon-900 rounded"
          onerror="this.style.display='none'" />
        <span class="font-display font-bold text-sm text-white uppercase">
          TJ <span class="text-industrial-yellow">FACTORY</span> — STAINLESS BOLT CNC 🇮🇩
        </span>
      </div>
      <div class="flex flex-wrap justify-center gap-5">
        <a href="#hero-medusa" class="inline-flex items-center min-h-[44px] sm:min-h-0 hover:text-industrial-yellow">Hero</a>
        <a href="#showcase-jacket" class="inline-flex items-center min-h-[44px] sm:min-h-0 hover:text-industrial-yellow">3D Baut</a>
        <a href="#anatomi-mouse" class="inline-flex items-center min-h-[44px] sm:min-h-0 hover:text-industrial-yellow">Anatomi</a>
        <a href="#katalog" class="inline-flex items-center min-h-[44px] sm:min-h-0 hover:text-industrial-yellow">Katalog</a>
        <a href={LINKS.shopee} target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center min-h-[44px] sm:min-h-0 hover:text-industrial-yellow">Shopee</a>
        <a href={LINKS.tokopedia} target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center min-h-[44px] sm:min-h-0 hover:text-industrial-yellow">Tokopedia</a>
      </div>
    </div>
  </footer>
