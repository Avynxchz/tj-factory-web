  <!-- ================= JAVASCRIPT: DUAL 3D STAGES (MEDUSA HERO + JACKET FLY-IN) + KATALOG ================= -->
  <script type="module">
    import * as THREE from 'three';
    import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';
    import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

    /* -------------------------------------------------------------------------- */
    /* 0. SCROLL-TRIGGERED FLOATING PILL NAVBAR                                   */
    /* -------------------------------------------------------------------------- */
    const mainNavbar = document.getElementById('main-navbar');
    window.addEventListener('scroll', () => {
      if (window.scrollY > window.innerHeight * 0.45) {
        mainNavbar.classList.remove('-translate-y-24', 'opacity-0', 'pointer-events-none');
        mainNavbar.classList.add('translate-y-0', 'opacity-100');
      } else {
        mainNavbar.classList.add('-translate-y-24', 'opacity-0', 'pointer-events-none');
        mainNavbar.classList.remove('translate-y-0', 'opacity-100');
      }
    });

    /* -------------------------------------------------------------------------- */
    /* 1. STAGE 1: HERO SECTION — 3D SPINNING TJ FACTORY EMBLEM & LIGHTING        */
    /* -------------------------------------------------------------------------- */
    function initHeroMedusa3D() {
      const heroSection = document.getElementById('hero-medusa');
      const cardLens = document.getElementById('hero-card-lens');
      const canvasEl = document.getElementById('hero-logo-3d-canvas');
      const emblemImg = document.getElementById('hero-3d-logo-img');
      const interactiveStage = document.getElementById('hero-3d-interactive-stage');
      const bgTypography = document.getElementById('hero-elegance-layer');

      if (!heroSection || !cardLens || !canvasEl) return;

      let targetMouseX = 0, targetMouseY = 0;
      let curMouseX = 0, curMouseY = 0;
      let isDragging = false;
      let startPointerX = 0;
      let manualSpinVel = 0;

      // Mouse tracking
      function handlePointerMove(e) {
        const rect = heroSection.getBoundingClientRect();
        const clientX = e.clientX ?? (e.touches && e.touches[0]?.clientX) ?? 0;
        const clientY = e.clientY ?? (e.touches && e.touches[0]?.clientY) ?? 0;
        targetMouseX = ((clientX - rect.left) / rect.width - 0.5) * 2;
        targetMouseY = ((clientY - rect.top) / rect.height - 0.5) * 2;

        if (isDragging) {
          const deltaX = clientX - startPointerX;
          manualSpinVel = deltaX * 0.004;
          if (emblemGroup) {
            emblemGroup.rotation.z += deltaX * 0.008;
          }
          startPointerX = clientX;
        }
      }

      function handlePointerLeave() {
        targetMouseX = 0;
        targetMouseY = 0;
      }

      heroSection.addEventListener('pointermove', handlePointerMove);
      heroSection.addEventListener('pointerleave', handlePointerLeave);

      if (interactiveStage) {
        interactiveStage.addEventListener('pointerdown', (e) => {
          isDragging = true;
          startPointerX = e.clientX ?? (e.touches && e.touches[0]?.clientX) ?? 0;
          interactiveStage.style.cursor = 'grabbing';
        });

        window.addEventListener('pointerup', () => {
          if (isDragging) {
            isDragging = false;
            interactiveStage.style.cursor = 'grab';
          }
        });
      }

      // Three.js Scene Setup for 3D Rolling Emblem
      let emblemGroup = new THREE.Group();
      let scene, camera, renderer;
      let topRimLight, goldKeyLight, sweepSpotLight, fillLight, bottomGlow;

      try {
        const width = interactiveStage ? interactiveStage.clientWidth : 500;
        const height = interactiveStage ? interactiveStage.clientHeight : 500;

        scene = new THREE.Scene();
        camera = new THREE.PerspectiveCamera(36, width / height, 0.1, 50);
        camera.position.set(0, 0, 4.3);

        renderer = new THREE.WebGLRenderer({ canvas: canvasEl, antialias: true, alpha: true, powerPreference: 'high-performance' });
        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 0.92; // Tenang, redup, tidak silau

        const pmrem = new THREE.PMREMGenerator(renderer);
        scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.03).texture;

        // Dynamic Sweeping Studio Lighting (Cahaya Bergerak Dinamis & Mengilat Pas Muter)
        // 1. Dynamic Overhead Rim Specular Light
        topRimLight = new THREE.DirectionalLight(0xffffff, 1.3);
        topRimLight.position.set(0, 5, 2.5);
        scene.add(topRimLight);

        // 2. Dynamic Warm Gold Key Light (Mengitari Bevel Emas)
        goldKeyLight = new THREE.DirectionalLight(0xffd56b, 1.5);
        goldKeyLight.position.set(4, 0, 3.5);
        scene.add(goldKeyLight);

        // 3. Dynamic Specular Sweeper Light (Menyapu Permukaan Logo)
        sweepSpotLight = new THREE.DirectionalLight(0xfff1b8, 1.1);
        sweepSpotLight.position.set(-3, 3, 3.2);
        scene.add(sweepSpotLight);

        // 4. Cool Slate Ambient Fill Light (Kontras Karbon Obsidian Redup)
        fillLight = new THREE.DirectionalLight(0x4a5568, 0.45);
        fillLight.position.set(-4, -2, 2);
        scene.add(fillLight);

        // 5. Soft Bottom Gold Glow Light (Pantulan Lembut Bawah)
        bottomGlow = new THREE.PointLight(0xf5b700, 0.85, 10);
        bottomGlow.position.set(0, -3.5, 2);
        scene.add(bottomGlow);

        scene.add(emblemGroup);

        // Load 3D GLB Model
        const loader = new GLTFLoader();
        loader.load(
          './aset/hero_3d_emblem.glb',
          (gltf) => {
            const root = gltf.scene;
            // Center & normalize model bounds
            const box = new THREE.Box3().setFromObject(root);
            const center = box.getCenter(new THREE.Vector3());
            const size = box.getSize(new THREE.Vector3());
            // Skala logo ekstra gagah (2.65) persis memenuhi lebar kartu kaca
            const scale = 2.65 / (maxDim || 1);
            root.scale.setScalar(scale);
            root.position.sub(center.multiplyScalar(scale));

            // Enhance gold & metallic materials with high-contrast specular reflections
            root.traverse((child) => {
              if (child.isMesh && child.material) {
                child.castShadow = true;
                child.receiveShadow = true;
                if (child.name.includes('gold')) {
                  child.material.color = new THREE.Color(0xdcb036);
                  child.material.metalness = 0.93;
                  child.material.roughness = 0.22; // Mengilat dengan kilau specular tegas
                } else if (child.name.includes('base')) {
                  child.material.color = new THREE.Color(0x181a20);
                  child.material.metalness = 0.82;
                  child.material.roughness = 0.42;
                }
              }
            });

            emblemGroup.add(root);
            // Model loaded: hide static fallback image smoothly
            if (emblemImg) {
              emblemImg.style.opacity = '0';
              setTimeout(() => { emblemImg.style.display = 'none'; }, 400);
            }
          },
          undefined,
          () => {
            // Fallback mode if GLB is loaded locally without HTTP server
            if (emblemImg) {
              emblemImg.style.display = 'block';
              emblemImg.style.opacity = '1';
            }
          }
        );

        // Responsive Resize
        window.addEventListener('resize', () => {
          if (!interactiveStage) return;
          const w = interactiveStage.clientWidth;
          const h = interactiveStage.clientHeight;
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
          renderer.setSize(w, h);
        });

      } catch (err) {
        console.warn('WebGL initialization fallback to 3D CSS:', err);
      }

      // Main Animation Loop
      let animTime = 0;
      let cssRotZ = 0;

      function renderLoop() {
        requestAnimationFrame(renderLoop);
        animTime += 0.02;

        curMouseX += (targetMouseX - curMouseX) * 0.08;
        curMouseY += (targetMouseY - curMouseY) * 0.08;

        // Smooth continuous rolling like a wheel / tire rolling (searah jarum jam pada sumbu Z)
        if (!isDragging) {
          if (emblemGroup) {
            emblemGroup.rotation.z -= 0.0035;
          }
          cssRotZ -= 0.2;
        }

        // Apply manual inertia velocity damping
        if (Math.abs(manualSpinVel) > 0.0001) {
          if (emblemGroup) emblemGroup.rotation.z += manualSpinVel;
          manualSpinVel *= 0.92;
        }

        // Dynamic Sweeping Studio Lighting:
        // Cahaya bergerak dinamis mengitari logo sehingga bevel-bevel emas memantulkan kilauan mewah saat berputar
        if (goldKeyLight && topRimLight && sweepSpotLight) {
          const tLight = animTime * 1.35;
          
          // Key Light mengitari permukaan depan dalam lintasan elips dinamis
          goldKeyLight.position.x = Math.sin(tLight) * 4.6 + 0.5;
          goldKeyLight.position.y = Math.cos(tLight * 0.75) * 3.2;
          goldKeyLight.position.z = Math.cos(tLight * 1.1) * 1.2 + 3.6;

          // Top Rim Light bergeser secara halus dari kiri ke kanan
          topRimLight.position.x = Math.cos(tLight * 0.85) * 3.8;
          topRimLight.position.y = Math.sin(tLight * 0.5) * 1.2 + 4.5;

          // Specular Sweeper menyapu secara diagonal berlawanan
          sweepSpotLight.position.x = Math.sin(-tLight * 0.95) * 4.0;
          sweepSpotLight.position.y = Math.cos(-tLight * 0.95) * 3.0;

          // Ambient Glow di bawah berdenyut halus
          if (bottomGlow) {
            bottomGlow.position.x = Math.sin(tLight * 0.6) * 1.8;
            bottomGlow.intensity = 0.75 + Math.sin(tLight * 1.8) * 0.25;
          }
        }

        // Subtle Mouse Parallax Tilt for 3D depth perception
        if (emblemGroup) {
          emblemGroup.rotation.x = -curMouseY * 0.18;
          emblemGroup.rotation.y = curMouseX * 0.22;
          emblemGroup.position.y = Math.sin(animTime) * 0.04;
        }

        // Fallback image 3D CSS rolling if WebGL is in fallback mode
        if (emblemImg && emblemImg.style.display !== 'none' && emblemImg.style.opacity !== '0') {
          const floatY = Math.sin(animTime) * 4;
          emblemImg.style.transform = `perspective(1000px) translateY(${floatY.toFixed(1)}px) rotateZ(${cssRotZ.toFixed(1)}deg) rotateX(${(-curMouseY * 8).toFixed(1)}deg) rotateY(${(curMouseX * 10).toFixed(1)}deg)`;
        }

        // Tilt Card Lens
        const cardTiltX = -curMouseY * 4.0;
        const cardTiltY = curMouseX * 5.0;
        cardLens.style.transform = `perspective(1200px) rotateX(${cardTiltX.toFixed(2)}deg) rotateY(${cardTiltY.toFixed(2)}deg)`;

        // Background Typography Counter-Parallax
        if (bgTypography) {
          const bgX = -curMouseX * 14;
          const bgY = -curMouseY * 7;
          bgTypography.style.transform = `translate3d(${bgX.toFixed(1)}px, ${bgY.toFixed(1)}px, 0)`;
        }

        if (renderer && scene && camera) {
          renderer.render(scene, camera);
        }
      }

      renderLoop();
    }

    /* -------------------------------------------------------------------------- */
