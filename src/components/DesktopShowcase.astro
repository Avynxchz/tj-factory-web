---
import { LINKS } from '../data/links.js';
// SHOWCASE DESKTOP (md+) ala mockup "Pengerajin Stainless Pemahat Baut Mesin CNC Indonesia."
// Foto terisi: dokumentasi = gambar baut CNC hasil generate; 3 kartu produk = poster dari Agus;
// banner = background generate + screenshot toko Shopee dari Agus.
// - Root hidden md:block: HP (<768px) TIDAK berubah sama sekali.
// - Section #tentang lama disembunyikan di md+ (md:hidden) agar tidak duplikat;
//   jangkar nav "Profil"/"Tentang" diarahkan ke #tentang-desktop di sini.
// - Slot foto sudah terisi gambar (bukan lagi kotak dashed).
const UNGGULAN = [
  {
    no: '01',
    title: 'Baut Stainless',
    desc: 'Tersedia berbagai ukuran dan tipe baut stainless untuk kebutuhan industri dan otomotif.',
    img: './aset/produk_baut.webp',
    alt: 'Poster baut stainless CNC TJ Factory',
  },
  {
    no: '02',
    title: 'Mur & Komponen',
    desc: 'Mur, ring, dan komponen pendukung lainnya dengan kualitas stainless terbaik.',
    img: './aset/produk_mur.webp',
    alt: 'Poster mur belakang TJ Factory',
  },
  {
    no: '03',
    title: 'Produk CNC',
    desc: 'Komponen presisi hasil pemotongan dan pemahatan CNC untuk performa maksimal.',
    img: './aset/produk_cnc.webp',
    alt: 'Poster semua produk TJ Factory',
  },
];
---
<div class="hidden md:block">
  <!-- ================= BLOK 1: DOKUMENTASI PROSES (versi desktop #tentang) ================= -->
  <section id="tentang-desktop" class="relative py-16 lg:py-20 bg-carbon-950 overflow-hidden border-b border-carbon-800">
    <div class="pointer-events-none absolute -top-20 right-0 w-96 h-96 rounded-full bg-[#FF6A1F]/10 blur-3xl"></div>
    <div class="relative max-w-7xl mx-auto px-8 grid md:grid-cols-2 gap-10 items-center">
      <div>
        <span class="font-mono text-xs text-[#FF6A1F] uppercase tracking-widest">// Dokumentasi Proses</span>
        <h2 class="font-medusa font-black text-4xl lg:text-5xl uppercase text-white leading-[1.05] mt-3">
          Pengerajin Stainless Pemahat Baut Mesin CNC Indonesia.
        </h2>
        <p class="text-slate-300 text-sm leading-relaxed mt-5">
          <strong class="text-white">TJ FACTORY</strong> memproduksi baut, mur head, as roda, baut visor, paket baut
          CVT matic, hingga cover head berbahan <strong class="text-white">Stainless Steel</strong> melalui proses
          pemahatan mesin CNC dan pemotongan CNC Laser.
        </p>
        <div class="mt-6 p-4 bg-carbon-900 border border-carbon-700 rounded-xl font-mono text-xs flex items-center justify-between gap-3">
          <span class="text-slate-400">Bidang Usaha:</span>
          <span class="text-white text-right">Manufaktur Baut &amp; Komponen Stainless CNC &rarr;</span>
        </div>
      </div>

      <div class="bg-carbon-900 border border-carbon-700 rounded-2xl p-4">
        <img src="./aset/dokumentasi_baut.webp" width="1200" height="675" loading="lazy" decoding="async"
          alt="Proses pemahatan baut stainless di mesin CNC TJ Factory"
          class="w-full aspect-[16/10] rounded-xl object-cover" />
        <div class="text-right font-mono text-[11px] leading-relaxed mt-4">
          <p class="text-slate-400">PRECISION</p>
          <p class="text-white font-bold">STAINLESS STEEL</p>
          <p class="text-slate-400">CNC MACHINING</p>
          <div class="ml-auto mt-2 w-10 h-[2px] bg-[#FF6A1F]"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= BLOK 2: BANNER SHOPEE (pendek ala mockup: HP bleed atas-bawah) ================= -->
  <section class="py-6 bg-carbon-950 border-b border-carbon-800">
    <div class="max-w-7xl mx-auto px-8">
      <div class="relative rounded-2xl overflow-hidden bg-gradient-to-br from-[#FF5A1F] via-[#E8490F] to-[#7A1E00]">
        <img src="./aset/shopee_banner_bg.webp" width="1600" height="533" loading="lazy" decoding="async" alt="" aria-hidden="true"
          class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/45 via-black/10 to-black/55"></div>
        <div class="relative px-8 lg:px-10 py-6 grid md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-5">
          <span class="font-mono text-xs text-white/80 uppercase tracking-widest">// Belanja Online</span>
          <h3 class="font-medusa font-black text-3xl lg:text-4xl uppercase text-white leading-tight mt-3">
            Temukan Produk Kami di Shopee!
          </h3>
          <p class="text-white/85 text-sm leading-relaxed mt-3">
            Baut stainless, mur, dan komponen CNC untuk berbagai kebutuhan.
          </p>
          <a href={LINKS.shopee} target="_blank" rel="noopener"
            class="mt-6 inline-flex items-center gap-2 px-6 py-3.5 rounded-lg bg-white text-[#E8490F] font-sans font-bold text-sm shadow-lg">
            KUNJUNGI TOKO SHOPEE <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- MOCKUP HP: screenshot toko Shopee dari Agus (miring ala referensi, bleed -my-20) -->
        <div class="md:col-span-4 -my-20">
          <a href={LINKS.shopee} target="_blank" rel="noopener" aria-label="Buka toko Shopee TJ Factory"
            class="block mx-auto w-full max-w-[200px] aspect-[9/19] rounded-[2rem] border-[6px] border-black bg-black shadow-2xl overflow-hidden rotate-[8deg]">
            <img src="./aset/shopee_store_hp.webp" width="600" height="1299" loading="lazy" decoding="async"
              alt="Toko Shopee TJ Factory" class="w-full h-full object-cover object-top" />
          </a>
        </div>

        <div class="md:col-span-3">
          <div class="flex items-center gap-2">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <span class="font-sans font-bold text-2xl text-white">Shopee</span>
          </div>
          <p class="font-mono text-xs tracking-[0.3em] text-white/80 mt-2">TJ FACTORY</p>
          <div class="h-px bg-white/30 my-4"></div>
          <ul class="space-y-3 text-white text-sm">
            <li class="flex items-center gap-2.5">
              <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" /></svg>
              Produk Original
            </li>
            <li class="flex items-center gap-2.5">
              <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
              Pengiriman Aman
            </li>
            <li class="flex items-center gap-2.5">
              <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>
              Banyak Pilihan Produk
            </li>
          </ul>
        </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= BLOK 3: PRODUK UNGGULAN ================= -->
  <section class="py-16 lg:py-20 bg-carbon-950 border-b border-carbon-800">
    <div class="max-w-7xl mx-auto px-8">
      <div class="flex items-end justify-between gap-6">
        <div>
          <span class="font-mono text-xs text-[#FF6A1F] uppercase tracking-widest">// Katalog &amp; Informasi Produk</span>
          <h3 class="font-medusa font-black text-3xl lg:text-4xl uppercase text-white mt-3">Produk Unggulan Kami</h3>
        </div>
        <a href="#katalog" class="shrink-0 font-mono text-xs text-[#FF6A1F] hover:text-white transition-colors">
          LIHAT SEMUA PRODUK &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mt-10">
        {UNGGULAN.map((c) => (
          <article class="border border-carbon-700 bg-carbon-900/60 rounded-2xl p-5 flex gap-4">
            <div class="flex gap-3 shrink-0">
              <span class="font-mono text-sm text-[#FF6A1F]">{c.no}</span>
              <span class="w-px self-stretch bg-[#FF6A1F]/40"></span>
            </div>
            <a href="#katalog" class="block w-28 shrink-0 aspect-[3/4] rounded-xl overflow-hidden">
              <img src={c.img} width="480" height="640" loading="lazy" decoding="async" alt={c.alt}
                class="w-full h-full object-cover" />
            </a>
            <div class="min-w-0">
              <h4 class="font-sans font-bold text-sm uppercase text-white">{c.title}</h4>
              <p class="text-slate-400 text-xs leading-relaxed mt-1.5">{c.desc}</p>
              <a href="#katalog"
                class="mt-3 inline-flex items-center gap-1 px-3 py-1.5 rounded-md border border-[#FF6A1F]/70 text-[#FF6A1F] font-mono text-[11px] hover:bg-[#FF6A1F] hover:text-carbon-950 transition-colors">
                Lihat Detail &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- STRIP BAWAH -->
  <div class="max-w-7xl mx-auto px-8 py-5 flex items-center justify-between font-mono text-[11px] tracking-widest">
    <span class="text-slate-500">KUALITAS / PRESISI / TERPERCAYA</span>
    <span class="text-slate-500"><span class="text-[#FF6A1F]">&mdash;</span> BUILT FOR BETTER PERFORMANCE</span>
  </div>
</div>
