              <span class="text-[10px] text-slate-400">Official Store ↗</span>
            </div>
          </a>

          <a href={LINKS.tokopedia} target="_blank" rel="noopener noreferrer"
            class="p-4 bg-carbon-900 border border-carbon-700 hover:border-[#03AC0E] rounded-xl group transition-all flex flex-col items-start sm:flex-row sm:items-center gap-3.5">
            <div
              class="w-11 h-11 rounded-lg bg-[#03AC0E] flex items-center justify-center shrink-0 overflow-hidden relative">
              <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none" aria-hidden="true"><path d="M6.3 9.2h11.4l.9 9.3c.1 1.3-.9 2.5-2.2 2.5H7.6c-1.3 0-2.3-1.2-2.2-2.5l.9-9.3z" fill="#fff"/><path d="M9.3 9.2V7.1c0-2 1.2-3.3 2.7-3.3s2.7 1.3 2.7 3.3v2.1" stroke="#fff" stroke-width="1.7" stroke-linecap="round"/></svg>
