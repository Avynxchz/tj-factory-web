                class="font-display font-bold text-sm sm:text-base text-white group-hover:text-pink-400 block">INSTAGRAM</span>
              <span class="text-[10px] text-slate-400">@tj.factory_ ↗</span>
            </div>
          </a>

          <a href="https://www.facebook.com/profile.php?id=100022283841654" target="_blank" rel="noopener noreferrer"
            class="col-span-2 sm:col-span-1 p-4 bg-carbon-900 border border-carbon-700 hover:border-[#1877F2] rounded-xl group transition-all flex flex-col items-start sm:flex-row sm:items-center gap-3.5">
