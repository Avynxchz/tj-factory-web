---
const labelCls = 'block font-mono text-xs text-slate-300 uppercase mb-1';
const inputCls = 'w-full bg-carbon-900 border border-carbon-700 focus:border-industrial-yellow rounded-lg px-3.5 py-2.5 text-sm text-white outline-none min-h-[44px] sm:min-h-0';
---
    <!-- ================= 7. BUSINESS INQUIRY / FORMULIR GROSIR B2B ================= -->
    <section id="permintaan-penawaran" class="py-14 sm:py-20 bg-carbon-900">
      <div class="max-w-4xl mx-auto px-4 sm:px-8">
        <div class="bg-carbon-950 border border-carbon-700 rounded-2xl p-6 sm:p-8">
          <div
            class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-carbon-800 pb-4 mb-6 gap-2">
            <div>
              <span class="font-mono text-[11px] text-industrial-yellow uppercase">// JALUR KONVERSI B2B, TOKO &
                GROSIR</span>
              <h2 class="font-display font-bold text-2xl sm:text-3xl uppercase text-white text-balance">
                Formulir Permintaan Penawaran
              </h2>
            </div>
            <!-- Nomor WA dicantumkan setelah konfirmasi owner -->
          </div>

          <form id="rfq-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="rfq-name" class={labelCls}>Nama Lengkap /
                  Bengkel *</label>
                <input type="text" id="rfq-name" required placeholder="Contoh: Hendra - Berkah Speedshop"
                  class={inputCls} />
              </div>
              <div>
                <label for="rfq-contact" class={labelCls}>Nomor WhatsApp /
                  Kontak *</label>
                <input type="text" id="rfq-contact" required placeholder="08xxxxxxxxxx"
                  class={inputCls} />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="sm:col-span-2">
                <label for="rfq-product" class={labelCls}>Pilih Material /
                  Paket Baut *</label>
                <select id="rfq-product" required
                  class={inputCls + ' cursor-pointer'}>
                  <option value="" disabled selected>-- Pilih Material / Paket Baut TJ FACTORY --</option>
                  <optgroup label="Komponen 3D Utama">
                    <option value="Baut Hex Stars Dual-Key">Baut Hex Stars Dual-Key (2 Kunci)</option>
                    <option value="Mur Head Ninja 12-Spline">Mur Head Ninja 12-Spline (High Stars)</option>
                    <option value="Baut Visor Payung Bintang 5">Baut Visor Payung Bintang 5 (Umbrella Stars)</option>
                  </optgroup>
                  <optgroup label="Katalog Baut Stainless CNC (10 Produk)">
                    <option value="Baut Stainless CNC 2 Kunci Drat 10 M6 tipe HEX NON by TJ Factory Handmade Probolt Indonesia">Baut Stainless CNC 2 Kunci Drat 10 M6 tipe HEX NON by TJ Factory Handmade Probolt Indonesia</option>
                    <option value="Baut Stainless CNC Drat 12 M8 Slim Untuk Cakram Disk Kaliper Honda By TJ Factory Handmade Probolt">Baut Stainless CNC Drat 12 M8 Slim Untuk Cakram Disk Kaliper Honda By TJ Factory Handmade Probolt</option>
                    <option value="Baut Stainless CNC 2 Kunci Drat 12 M8 tipe HEX PLUS by TJ Factory Handmade Probolt Indonesia">Baut Stainless CNC 2 Kunci Drat 12 M8 tipe HEX PLUS by TJ Factory Handmade Probolt Indonesia</option>
                    <option value="Ring Spiral Lebar Stainless M6 drat 10 Tambahan Ring Untuk HEX NON M6">Ring Spiral Lebar Stainless M6 drat 10 Tambahan Ring Untuk HEX NON M6</option>
                    <option value="Mur Topi Ring M10 Drat 14 picth 1,25 Stainless CNC Shock Belakang RX KING Drat HALUS By TJ Factory (1pcs)">Mur Topi Ring M10 Drat 14 picth 1,25 Stainless CNC Shock Belakang RX KING Drat HALUS By TJ Factory (1pcs)</option>
                    <option value="Baut Stainless CNC Drat 14 M10 Drat Halus Picth 1,25 mm 2 Kunci tipe HEX PLUS Handmade Probolt">Baut Stainless CNC Drat 14 M10 Drat Halus Picth 1,25 mm 2 Kunci tipe HEX PLUS Handmade Probolt</option>
                    <option value="1 Set Baut Stainless CNC Nap Gear RX KING FIZR JUPITER VEGA Slim dan 2 kunci by TJ Factory Probolt">1 Set Baut Stainless CNC Nap Gear RX KING FIZR JUPITER VEGA Slim dan 2 kunci by TJ Factory Probolt</option>
                    <option value="Mur 12 14 17 19 Stainless CNC Mur M8 M10 M12 M14 Tipe Hex Stars By TJ Factory Probolt Indonesia">Mur 12 14 17 19 Stainless CNC Mur M8 M10 M12 M14 Tipe Hex Stars By TJ Factory Probolt Indonesia</option>
                    <option value="Baut Stainless CNC Drat 12 M8 Slim Untuk Cakram Disk Kaliper By TJ Factory Handmade Probolt (1biji)">Baut Stainless CNC Drat 12 M8 Slim Untuk Cakram Disk Kaliper By TJ Factory Handmade Probolt (1biji)</option>
                    <option value="1 Set Baut Stainless CNC Raiser Stang 2 kunci Klem Stang RX KING Ninja SS">1 Set Baut Stainless CNC Raiser Stang 2 kunci Klem Stang RX KING Ninja SS</option>
                  <option value="Pesanan Partai Campuran / Custom">Pesanan Partai Campuran / Custom Beberapa Tipe
                    </option>
                  </optgroup>
                </select>
              </div>
              <div>
                <label for="rfq-qty" class={labelCls}>Jumlah *</label>
                <input type="text" id="rfq-qty" required placeholder="Misal: 10 Set / 100 Pcs"
                  class={inputCls} />
              </div>
            </div>

            <div>
              <label for="rfq-notes" class={labelCls}>Catatan Ukuran / Drat
                (Opsional)</label>
              <input type="text" id="rfq-notes" placeholder="Detail ukuran drat M6/M8/M10 atau kombinasi paket..."
                class={inputCls} />
            </div>

            <button type="submit"
              class="w-full py-3.5 rounded-full bg-industrial-yellow hover:bg-industrial-amber text-carbon-950 font-display font-bold uppercase tracking-wider text-sm transition-all shadow-lg">
              Buat & Salin Format Penawaran Resmi
            </button>
          </form>

          <div id="rfq-confirmation"
            class="hidden mt-5 p-4 bg-carbon-900 border border-industrial-yellow rounded-xl space-y-3">
            <div class="flex items-center justify-between gap-3">
              <span id="rfq-copy-status" class="font-mono text-xs text-industrial-yellow font-bold">✓ FORMAT PESANAN TERSALIN</span>
              <button type="button" id="btn-copy-rfq"
                class="px-3 py-1 rounded bg-industrial-yellow text-carbon-950 font-mono text-xs font-bold min-h-[44px] sm:min-h-0">
                Salin Ulang
              </button>
            </div>
            <pre id="rfq-preview-text"
              class="text-xs font-mono text-slate-200 whitespace-pre-wrap break-words bg-carbon-950 p-3 border border-carbon-700 rounded-lg"></pre>
          </div>
        </div>
      </div>
    </section>

