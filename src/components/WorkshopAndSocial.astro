#fff"/></svg>
            </div>
            <div>
              <span
                class="font-display font-bold text-sm sm:text-base text-white group-hover:text-cyan-400 block">TIKTOK
                SHOP</span>
              <span class="text-[10px] text-slate-400">@tj.factory_ ↗</span>
            </div>
          </a>

