<!-- ================= SECTION: ABOUT US AND WHY US ================= -->
    <section id="about-us-section"
      class="relative py-20 sm:py-28 bg-[#040406] text-white overflow-hidden border-b border-carbon-800">

      <div class="text-center max-w-2xl mx-auto px-4 mb-14 sm:mb-16 relative z-20">
        <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl uppercase tracking-wider text-white">
          TENTANG TJ FACTORY
        </h2>
        <p class="font-mono text-xs sm:text-sm text-industrial-yellow uppercase tracking-widest mt-1">
          // PROFIL & KEUNGGULAN PRODUKSI
        </p>
        <p class="font-sans text-xs sm:text-sm text-slate-400 mt-4 max-w-lg mx-auto leading-relaxed">
          Kami adalah pengerajin stainless pemahat baut dan komponen motor dengan proses mesin CNC serta CNC Laser
          buatan Indonesia.
        </p>
      </div>

      <!-- 3 OVERLAPPING CARDS -->
      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 flex flex-col lg:flex-row items-center justify-center">

        <div
          class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[340px] sm:w-[460px] pointer-events-none select-none z-0 opacity-70 mix-blend-screen overflow-hidden">
          <img src="./aset/about_hand_statue.jpg" alt="Visual Dokumentasi"
            class="w-full h-auto object-contain [mask-image:radial-gradient(ellipse_at_center,black_60%,transparent_95%)]"
            onerror="this.style.display='none'" />
        </div>

        <!-- Card 3: Left -->
        <div
          class="w-full lg:w-[340px] bg-white text-carbon-950 p-7 sm:p-9 rounded-[30px] shadow-2xl relative z-10 lg:-mr-10 order-2 lg:order-1 mb-4 lg:mb-0 transform hover:-translate-y-1 transition-transform">
          <h3 class="font-display font-bold text-lg sm:text-xl text-carbon-950 mb-3 uppercase">
            3. Paket Set Spesifik Motor
          </h3>
          <p class="font-sans text-xs sm:text-sm text-slate-600 leading-relaxed">
            Tersedia dalam paket set lengkap sesuai titik mesin (Ninja R/RR, RX King, F1ZR, Tiger, hingga CVT Mio, Beat,
            Vario, PCX, dan ADV) maupun ukuran eceran M6, M8, dan M10.
          </p>
        </div>

        <!-- Card 1: Center -->
        <div
          class="w-full lg:w-[410px] bg-[#16181F]/90 backdrop-blur-2xl border border-white/15 text-white p-8 sm:p-10 rounded-[36px] shadow-[0_30px_90px_rgba(0,0,0,0.95)] relative z-20 order-1 lg:order-2 mb-4 lg:mb-0 transform hover:-translate-y-2 transition-transform">
          <h3 class="font-display font-bold text-xl sm:text-2xl text-white mb-3 uppercase">
            1. Material Stainless<br />& Proses Mesin CNC
          </h3>
          <p class="font-sans text-xs sm:text-sm text-slate-300 leading-relaxed mb-10">
            Menggunakan bahan Stainless Steel berkualitas (termasuk seri SUS 304 pada Cover Head 125Z CNC Laser) dengan
            desain kepala khas seperti HEX STARS 2 Kunci, HIGH STARS, dan UMBRELLA STARS.
          </p>
          <div class="flex items-center justify-between pt-5 border-t border-white/10 text-xs sm:text-sm">
            <span class="text-slate-400 font-mono text-[11px] leading-tight">
              MADE IN INDONESIA 🇮🇩<br />PRESISI ULIR CNC
            </span>
            <a href="#katalog" class="text-xl text-industrial-yellow font-mono" title="Lihat Katalog">↗</a>
          </div>
        </div>

        <!-- Card 2: Right -->
        <div
