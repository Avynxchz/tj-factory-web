---
const FILTER_ACTIVE = 'cat-btn shrink-0 px-4 py-2 rounded-full text-xs font-mono uppercase bg-industrial-yellow text-carbon-950 font-bold transition-all min-h-[44px] sm:min-h-0';
const FILTER_INACTIVE = 'cat-btn shrink-0 px-4 py-2 rounded-full text-xs font-mono uppercase bg-carbon-900 text-slate-300 border border-carbon-700 hover:border-industrial-yellow transition-all min-h-[44px] sm:min-h-0';
const FILTERS = [
  { cat: 'ALL', label: 'Semua Produk (19)' },
  { cat: 'NINJA', label: 'Ninja R/RR' },
  { cat: 'SPORT_2TAK', label: 'RX King / F1ZR / Tiger' },
  { cat: 'CVT_MATIC', label: 'CVT Matic' },
  { cat: 'BAUT_ECERAN', label: 'Baut M6 / M8 / M10' },
  { cat: 'CNC_LASER', label: 'CNC Laser' },
];
---
    <!-- ================= 4. CURVED 3D PERSPECTIVE SHOWCASE & FULL CATALOG ================= -->
    <section id="katalog" class="py-16 sm:py-24 bg-carbon-950 border-b border-carbon-800 overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-8">

        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="font-mono text-xs text-industrial-yellow uppercase tracking-widest">// TOP PICKS & FULL
            CATALOG</span>
          <h2 class="font-display font-bold text-3xl sm:text-5xl uppercase text-white mt-2 leading-tight text-balance">
            Katalog Sparepart & <br /><span class="text-industrial-yellow">Baut Stainless CNC</span>
          </h2>
          <p class="text-slate-400 text-xs sm:text-sm mt-3">
            Klik kartu produk untuk membuka galeri detail multi-sudut dan tautan toko resmi (Shopee, Tokopedia, TikTok
            Shop), atau ajukan penawaran harga grosir.
          </p>
        </div>

        <div class="relative my-10">
          <div
            class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-72 h-72 rounded-full bg-industrial-yellow/15 blur-3xl">
          </div>

          <div class="toppicks-marquee overflow-hidden py-6" id="mouse-strip-items">
            <div class="toppicks-track flex items-stretch w-max">
              <div onclick="window.openProductDetail('TJF-SP-01')"
                class="shrink-0 w-60 sm:w-64 mr-4 sm:mr-5 bg-carbon-900 border border-carbon-700 hover:border-industrial-yellow rounded-2xl overflow-hidden cursor-pointer transition-colors group">
                <div class="aspect-[3/4] relative overflow-hidden bg-carbon-950">
                  <img src="./Material/hex-star/id-11134207-822wp-mo2b6elumy2t4a.webp"
                    onerror="this.src='https://images.msha.ke/cf0c14cd-9bb6-4da2-a0f3-6722d9620748?w=600'"
                    alt="Bak Kalter RX King"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-carbon-950 via-carbon-950/80 to-transparent p-4">
                    <span class="font-mono text-[10px] text-industrial-yellow">18 PCS // 2 KUNCI</span>
                    <h3 class="font-display font-bold text-base text-white uppercase">Bak Kalter RX King</h3>
                  </div>
                </div>
              </div>
              <div onclick="window.openProductDetail('TJF-NJ-02')"
                class="shrink-0 w-60 sm:w-64 mr-4 sm:mr-5 bg-carbon-900 border border-carbon-700 hover:border-industrial-yellow rounded-2xl overflow-hidden cursor-pointer transition-colors group">
                <div class="aspect-[3/4] relative overflow-hidden bg-carbon-950">
                  <img src="./Material/mud-head-ninja-3R/id-11134207-8224q-mhlni6mwmdxg3b.webp"
                    onerror="this.src='https://images.msha.ke/7b448005-f2c2-49e5-8bea-f03468647676?w=600'"
                    alt="Mur Head Ninja R RR"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-carbon-950 via-carbon-950/80 to-transparent p-4">
                    <span class="font-mono text-[10px] text-industrial-yellow">HIGH STARS CROWN</span>
                    <h3 class="font-display font-bold text-base text-white uppercase">Mur Head Ninja R/RR</h3>
                  </div>
                </div>
              </div>
              <div onclick="window.openProductDetail('TJF-NJ-06')"
                class="shrink-0 w-60 sm:w-64 mr-4 sm:mr-5 bg-carbon-900 border-2 border-industrial-yellow rounded-2xl overflow-hidden cursor-pointer transition-colors relative shadow-[0_0_45px_rgba(245,183,0,0.22)] group">
                <div class="aspect-[3/4] relative overflow-hidden bg-carbon-950">
                  <img src="./Material/BAUT.png"
                    onerror="this.src='https://images.msha.ke/39a66401-ea82-4d9a-b9b1-a6e51557c2f1?w=800'"
                    alt="Full Set Baut Stainless CNC Ninja"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  <div class="absolute top-3 left-3 z-20 px-2.5 py-0.5 rounded-full bg-industrial-yellow text-carbon-950 font-mono font-bold text-[10px]">
                    BEST SELLER
                  </div>
                  <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-carbon-950 via-carbon-950/80 to-transparent p-4 z-20">
                    <span class="font-mono text-[10px] text-industrial-yellow">22 + 8 + 8 PCS</span>
                    <h3 class="font-display font-bold text-lg text-white uppercase">Full Set Ninja 2-Tak</h3>
                  </div>
                </div>
              </div>
              <div onclick="window.openProductDetail('TJF-NJ-01')"
                class="shrink-0 w-60 sm:w-64 mr-4 sm:mr-5 bg-carbon-900 border border-carbon-700 hover:border-industrial-yellow rounded-2xl overflow-hidden cursor-pointer transition-colors group">
                <div class="aspect-[3/4] relative overflow-hidden bg-carbon-950">
                  <img src="./Material/hex-star/id-11134207-7r98t-lqa79zlxhdke71.webp"
                    onerror="this.src='https://images.msha.ke/9557f023-860b-42d6-b662-058a19771596?w=600'"
                    alt="Baut Bak Kalter Ninja"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-carbon-950 via-carbon-950/80 to-transparent p-4">
                    <span class="font-mono text-[10px] text-industrial-yellow">HEX STARS 2 KUNCI</span>
                    <h3 class="font-display font-bold text-base text-white uppercase">Bak Kalter Ninja R/RR</h3>
                  </div>
                </div>
              </div>
              <div onclick="window.openProductDetail('TJF-LSR-01')"
                class="shrink-0 w-60 sm:w-64 mr-4 sm:mr-5 bg-carbon-900 border border-carbon-700 hover:border-industrial-yellow rounded-2xl overflow-hidden cursor-pointer transition-colors group">
                <div class="aspect-[3/4] relative overflow-hidden bg-carbon-950">
                  <img src="https://images.msha.ke/4d6aeb97-3544-47cc-8695-7e26f77e3442?auto=format%2Ccompress&cs=tinysrgb&q=80&w=828"
                    onerror="this.onerror=null; this.src='./Material/BAUT.png';"
                    alt="Cover Head 125Z CNC Laser"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-carbon-950 via-carbon-950/80 to-transparent p-4 z-20">
                    <span class="font-mono text-[10px] text-industrial-yellow">SUS 304 CNC LASER</span>
                    <h3 class="font-display font-bold text-base text-white uppercase">Cover Head 125Z</h3>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- FILTER & SEARCH BAR -->
        <div class="mt-14 pt-10 border-t border-carbon-800">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
            <div class="flex items-center gap-2 overflow-x-auto pb-2 md:pb-0 no-scrollbar" id="catalog-filters">
              {FILTERS.map((f) => (
                <button type="button" data-cat={f.cat} class={f.cat === 'ALL' ? FILTER_ACTIVE : FILTER_INACTIVE}>
                  {f.label}
                </button>
              ))}
            </div>

            <div class="w-full md:w-72">
              <input type="search" id="catalog-search" placeholder="Cari baut, Ninja, RX King, M6..."
                class="w-full bg-carbon-900 border border-carbon-700 focus:border-industrial-yellow rounded-full px-4 py-2 text-xs sm:text-sm text-white placeholder-slate-500 outline-none font-mono min-h-[44px] md:min-h-0" />
            </div>
          </div>

          <div id="catalog-grid" class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-6"></div>
        </div>

      </div>
    </section>

