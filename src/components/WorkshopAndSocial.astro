---
import { LINKS } from '../data/links.js';
---
    <!-- ================= 5. WORKSHOP PROFIL ================= -->
    <section id="tentang" class="py-14 sm:py-20 bg-carbon-900 border-b border-carbon-800 bg-cad-grid">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-14">

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-6 space-y-4">
            <span class="font-mono text-xs text-industrial-yellow uppercase tracking-widest">// DOKUMENTASI
              PROSES</span>
            <h2 class="font-display font-bold text-3xl sm:text-4xl uppercase text-white leading-tight">
              Pengerajin Stainless Pemahat Baut Mesin CNC Indonesia.
            </h2>
            <p class="text-slate-300 text-sm leading-relaxed">
              <strong>TJ FACTORY</strong> memproduksi baut, mur head, as roda, baut visor, paket baut CVT matic, hingga
              cover head berbahan <strong>Stainless Steel</strong> melalui proses pemahatan mesin CNC dan pemotongan CNC
              Laser.
            </p>
            <div class="p-4 bg-carbon-950 border border-carbon-700 rounded-xl font-mono text-xs space-y-1.5">
              <div class="flex justify-between gap-3">
                <span class="text-slate-400">Bidang Usaha:</span>
                <span class="text-white">Manufaktur Baut & Komponen Stainless CNC</span>
              </div>
              <!-- Baris Tahun Berdiri & Kapasitas Produksi disembunyikan sampai konfirmasi owner -->
            </div>
          </div>

          <div class="lg:col-span-6">
            <div class="bg-carbon-950 border border-carbon-700 rounded-2xl p-4">
              <div class="relative aspect-video rounded-xl overflow-hidden bg-carbon-900 border border-carbon-800">
                <img id="about-fallback-img" src="./Material/BAUT.png" width="800" height="450" loading="lazy" decoding="async"
                  onerror="this.src='https://images.msha.ke/806cbbbe-7c26-4d95-8604-974683d6e8f0?w=828'"
                  alt="Produk Baut CNC TJ FACTORY" class="w-full h-full object-cover" />
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ================= 6. OFFICIAL MARKETPLACE & SOCIAL HUB ================= -->
    <section id="channel-resmi" class="py-12 sm:py-16 bg-carbon-950 border-b border-carbon-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-8">
        <div class="text-center max-w-xl mx-auto mb-8">
          <span class="font-mono text-[11px] text-industrial-yellow uppercase tracking-widest">// KANAL RESMI TJ
            FACTORY</span>
          <h2 class="font-display font-bold text-2xl sm:text-3xl uppercase text-white mt-1">
            Official Marketplace & Social Links
          </h2>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4 font-mono text-xs">
          <a href={LINKS.shopee} target="_blank" rel="noopener noreferrer"
            class="p-4 bg-carbon-900 border border-carbon-700 hover:border-[#EE4D2D] rounded-xl group transition-all flex flex-col items-start sm:flex-row sm:items-center gap-3.5">
            <div
              class="w-11 h-11 rounded-lg bg-[#EE4D2D] flex items-center justify-center shrink-0">
              <svg viewBox="0 0 24 24" class="w-7 h-7" fill="#fff" aria-hidden="true"><path d="M15.9414 17.9633c.229-1.879-.981-3.077-4.1758-4.0969-1.548-.528-2.277-1.22-2.26-2.1719.065-1.056 1.048-1.825 2.352-1.85a5.2898 5.2898 0 0 1 2.8838.89c.116.072.197.06.263-.039.09-.145.315-.494.39-.62.051-.081.061-.187-.068-.281-.185-.1369-.704-.4149-.983-.5319a6.4697 6.4697 0 0 0-2.5118-.514c-1.909.008-3.4129 1.215-3.5389 2.826-.082 1.1629.494 2.1078 1.73 2.8278.262.152 1.6799.716 2.2438.892 1.774.552 2.695 1.5419 2.478 2.6969-.197 1.047-1.299 1.7239-2.818 1.7439-1.2039-.046-2.2878-.537-3.1278-1.19l-.141-.11c-.104-.08-.218-.075-.287.03-.05.077-.376.547-.458.67-.077.108-.035.168.045.234.35.293.817.613 1.134.775a6.7097 6.7097 0 0 0 2.8289.727 4.9048 4.9048 0 0 0 2.0759-.354c1.095-.465 1.8029-1.394 1.9449-2.554zM11.9986 1.4009c-2.068 0-3.7539 1.95-3.8329 4.3899h7.6657c-.08-2.44-1.765-4.3899-3.8328-4.3899zm7.8516 22.5981-.08.001-15.7843-.002c-1.074-.04-1.863-.91-1.971-1.991l-.01-.195L1.298 6.2858a.459.459 0 0 1 .45-.494h4.9748C6.8448 2.568 9.1607 0 11.9996 0c2.8388 0 5.1537 2.5689 5.2757 5.7898h4.9678a.459.459 0 0 1 .458.483l-.773 15.5883-.007.131c-.094 1.094-.979 1.9769-2.0709 2.0059z"/></svg>
            </div>
            <div>
