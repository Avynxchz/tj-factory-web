    document.getElementById('btn-jacket-next').addEventListener('click', () => {
      activeJacketIdx = (activeJacketIdx + 1) % partsData.length;
      updateJacketUI();
    });

    document.getElementById('btn-next-preview-label')?.addEventListener('click', () => {
      activeJacketIdx = (activeJacketIdx + 1) % partsData.length;
      updateJacketUI();
