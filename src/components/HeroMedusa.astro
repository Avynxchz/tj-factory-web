---
import { LINKS } from '../data/links.js';
---
    <!-- ================= 1. HERO SECTION: PERSIS KOMPOSISI MEDUSA "ELEGANCE" ================= -->
    <section id="hero-medusa"
      class="relative w-full min-h-screen max-h-[1080px] hero-medusa-stage flex flex-col justify-between py-6 sm:py-8 px-5 sm:px-10 overflow-hidden select-none border-b border-carbon-800">

      <!-- Vignette Gelap di Sekeliling Layar -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-transparent to-[#040507] pointer-events-none z-0">
      </div>

      <!-- TOP BAR (mobile ala referensi: logo + wordmark, pil outline emas; sm+ tidak berubah) -->
      <div class="relative z-30 w-full max-w-7xl mx-auto flex justify-between sm:grid sm:grid-cols-3 items-center pt-1">
        <div class="flex items-center gap-2.5">
          <img src="./aset/logo.webp" width="32" height="32" fetchpriority="high" decoding="async" onerror="this.onerror=null; this.src='./aset/logo.png'" alt="Logo TJ FACTORY" class="w-10 h-10 sm:w-8 sm:h-8 object-contain opacity-90"
            onerror="this.style.display='none'" />
          <span class="sm:hidden font-display font-bold text-base tracking-wider uppercase text-white">
            TJ <span class="text-industrial-yellow">FACTORY</span>
          </span>
          <span class="hidden sm:inline font-mono text-[10px] tracking-[0.2em] uppercase text-slate-400">
            MADE IN INDONESIA 🇮🇩
          </span>
        </div>

        <div class="text-center hidden md:block">
          <span class="font-sans font-normal text-xs sm:text-sm tracking-[0.55em] lowercase text-slate-300/90">
            c n c &nbsp; s t a i n l e s s
          </span>
        </div>

        <div class="flex items-center justify-end gap-2">
          <a href="#katalog" onclick="setTimeout(() => document.getElementById('catalog-search')?.focus(), 400)"
            class="px-3.5 sm:px-4 py-1.5 rounded-full bg-transparent border border-industrial-yellow/90 text-white hover:bg-industrial-yellow hover:text-carbon-950 sm:bg-white sm:border-transparent sm:text-carbon-950 font-sans font-semibold text-[11px] sm:text-xs flex items-center gap-1.5 shadow-lg transition-all min-h-[44px] sm:min-h-0">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
            </svg>
            <span>Cari</span>
          </a>
          <a href={LINKS.shopee} target="_blank" rel="noopener" title="Toko Shopee TJ FACTORY"
            class="h-8 px-3 rounded-full bg-transparent border border-industrial-yellow/90 text-white hover:bg-industrial-yellow hover:text-carbon-950 sm:bg-white sm:border-transparent sm:text-carbon-950 flex items-center gap-1.5 shadow-lg transition-all font-sans font-semibold text-[11px] sm:text-xs min-h-[44px] sm:min-h-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <span>Shopee</span>
          </a>
        </div>
      </div>

      <!-- EYEBROW MOBILE (sm:hidden): ala referensi -->
      <div class="relative z-30 w-full max-w-7xl mx-auto flex items-center justify-center gap-3 pt-4 sm:hidden">
        <span class="h-px w-8 bg-industrial-yellow"></span>
        <span class="font-mono text-[10px] tracking-[0.35em] uppercase text-slate-200/90">
          Precision CNC Components
        </span>
        <span class="h-px w-8 bg-industrial-yellow"></span>
      </div>

      <!-- CENTER STAGE: GIANT TEXT DI TENGAH + KARTU KACA PEDESTAL + LOGO 3D MENYEMBUL DI ATAS KACA -->
      <div class="relative w-full max-w-7xl mx-auto flex-1 flex items-center justify-center my-auto">

        <!-- LAYER 1 (Z-0): TULISAN RAKSASA "TJ FACTORY" -->
        <div id="hero-elegance-layer"
          class="absolute inset-x-0 top-[38%] sm:top-[36%] -translate-y-1/2 z-0 flex items-center justify-center pointer-events-none select-none">
          <div
            class="hidden sm:block medusa-giant-text text-[17vw] xl:text-[235px] uppercase text-center whitespace-nowrap tracking-tight">
            TJ FACTORY
          </div>
          <h1
            class="sm:hidden medusa-giant-text text-[16vw] uppercase text-center whitespace-nowrap tracking-tighter">
            TJ FACTORY
          </h1>
        </div>

        <!-- LAYER 2 (Z-10): KARTU KACA PEDESTAL -->
        <div id="hero-card-lens"
          class="relative z-10 w-full max-w-none sm:w-[86vw] sm:max-w-[430px] md:max-w-[460px] h-auto sm:h-[520px] rounded-none sm:rounded-t-[62px] sm:rounded-b-[20px] medusa-glass-pedestal flex flex-col items-center justify-between px-0 sm:px-9 pb-0 sm:pb-5 pt-0 mt-0 sm:mt-20 transition-transform duration-150 ease-out">

          <div
            class="pointer-events-none absolute top-6 sm:top-14 left-1/2 -translate-x-1/2 w-72 h-72 sm:w-56 sm:h-56 rounded-full bg-industrial-yellow/25 sm:bg-industrial-yellow/15 blur-[60px] sm:blur-[55px] z-0">
          </div>

          <!-- LAYER 3 (Z-20): OBJEK 3D LOGO TJ FACTORY -->
          <div id="hero-3d-interactive-stage"
            class="relative mt-0 sm:-mt-14 w-full max-w-[340px] aspect-square sm:w-[360px] sm:max-w-none sm:h-[360px] sm:aspect-auto flex items-center justify-center cursor-grab active:cursor-grabbing z-20 shrink-0"
            title="Tahan & geser untuk memutar Logo 3D TJ FACTORY">
            <canvas id="hero-logo-3d-canvas"
              class="w-full h-full object-contain absolute inset-0 z-10"></canvas>

            <img id="hero-3d-logo-img" src="./aset/hero_3d_emblem.webp" width="360" height="360" fetchpriority="high" decoding="async" onerror="this.onerror=null; this.src='./aset/hero_3d_emblem.png'"
              alt="Logo 3D TJ FACTORY"
              class="w-full h-full object-contain medusa-3d-object-shadow select-none pointer-events-none z-0" />
          </div>

          <!-- LAYER 4 (Z-30): BAGIAN BAWAH DI DALAM KACA (sm+ saja; mobile pakai blok baru di bawah) -->
          <div class="relative z-30 w-full max-w-[320px] hidden sm:flex flex-col items-center space-y-3.5 mt-auto pb-1">

            <div class="w-full flex items-baseline justify-between px-1">
              <span class="font-sans font-semibold text-base sm:text-xl text-white/90 tracking-wide">
                Material
              </span>
              <span class="font-sans font-bold text-lg sm:text-2xl text-white tracking-tight">
                SUS 304 <span class="text-industrial-yellow">CNC</span>
              </span>
            </div>

            <a href="#showcase-jacket"
              class="w-full py-3 sm:py-3.5 px-6 rounded-full bg-white hover:bg-industrial-yellow text-carbon-950 font-sans font-bold text-xs sm:text-sm tracking-wide flex items-center justify-center gap-2.5 shadow-[0_10px_30px_rgba(0,0,0,0.8)] transition-all duration-300 hover:scale-[1.02] active:scale-95 min-h-[44px] sm:min-h-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2"
                  d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" />
              </svg>
              <span>Lihat Produk</span>
            </a>

            <div class="flex flex-col items-center gap-2 pt-0.5">
              <a href="#permintaan-penawaran"
                class="inline-flex items-center min-h-[44px] sm:min-h-0 font-mono text-[10px] sm:text-[11px] uppercase tracking-widest text-slate-400 hover:text-industrial-yellow transition-colors">
                Hubungi Kami / Penawaran Grosir →
              </a>
              <div class="w-20 h-[1.5px] bg-white/40 rounded-full"></div>
            </div>

          </div>

          <!-- BLOK INFO MOBILE (sm:hidden): headline + CTA kuning ala referensi -->
          <div class="relative z-30 w-full flex flex-col items-center text-center sm:hidden pt-4">
            <h2 class="font-medusa font-black uppercase leading-[0.95] tracking-tight">
              <span class="block text-[10vw] whitespace-nowrap text-white">Stainless CNC</span>
              <span class="block text-[10vw] whitespace-nowrap text-transparent bg-clip-text bg-gradient-to-b from-zinc-100 via-zinc-300 to-zinc-500">Components</span>
            </h2>
            <p class="mt-3 font-mono text-[11px] tracking-[0.3em] uppercase text-slate-300/90">
              SUS 304 &bull; CNC Precision
            </p>
            <a href="#showcase-jacket"
              class="mt-5 w-full max-w-[300px] py-4 px-6 rounded-full bg-industrial-yellow text-carbon-950 font-sans font-bold text-sm tracking-wide flex items-center justify-center gap-2 shadow-[0_10px_40px_rgba(245,183,0,0.35)] transition-all active:scale-95 min-h-[44px]">
              <span>Lihat Produk</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
            <a href="#permintaan-penawaran"
              class="mt-3 inline-flex items-center gap-1 min-h-[44px] font-sans text-sm text-slate-200 underline underline-offset-4 decoration-white/40">
              Penawaran Grosir <span aria-hidden="true">&nearr;</span>
            </a>
          </div>

        </div>

      </div>

      <!-- SIDE CAPTIONS (sm+ saja; mobile pakai blok bawah baru) -->
      <div class="relative z-30 w-full max-w-7xl mx-auto hidden sm:flex items-end justify-between gap-3 pb-1">
        <div class="flex flex-col items-start gap-3">
          <p class="text-[10px] md:text-[11px] text-slate-300/90 font-sans leading-relaxed max-w-[150px] md:max-w-[210px]">
            Pengerajin stainless pemahat baut &mdash; presisi mesin CNC &#x1F1EE;&#x1F1E9;
          </p>
          <a href="#showcase-jacket" aria-label="Scroll ke 3D Baut Showcase"
            class="w-10 h-10 rounded-full bg-carbon-900/90 hover:bg-industrial-yellow text-slate-300 hover:text-carbon-950 border border-white/15 flex items-center justify-center transition-all duration-300 shadow-lg min-h-[44px] min-w-[44px] sm:min-h-0 sm:min-w-0">
            ↓
          </a>
        </div>

        <div class="text-right">
          <p class="text-[10px] md:text-[11px] text-slate-300/90 font-sans leading-relaxed max-w-[150px] md:max-w-[240px]">
            Baut mesin &bull; mur head &bull; as roda &bull; paket CVT matic
          </p>
        </div>
      </div>

      <!-- BAWAH MOBILE (sm:hidden): divider + kategori + chevron ala referensi -->
      <div class="relative z-30 w-full max-w-7xl mx-auto flex flex-col items-center gap-4 pb-2 sm:hidden">
        <div class="relative w-full h-px bg-white/20">
          <span class="absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 w-16 h-[3px] bg-industrial-yellow rounded-full"></span>
        </div>
        <p class="font-mono text-[10px] tracking-[0.25em] uppercase text-slate-300/90 text-center">
          Baut Mesin &bull; Mur Head &bull; Paket CVT
        </p>
        <a href="#showcase-jacket" aria-label="Scroll ke 3D Baut Showcase"
          class="text-slate-300/80 hover:text-industrial-yellow transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 9l6 6 6-6M6 15l6 6 6-6" />
          </svg>
        </a>
      </div>

    </section>

