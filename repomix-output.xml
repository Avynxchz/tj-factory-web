  <!-- 3D ENGINE JAVASCRIPT -->
  <script type="module">
    import * as THREE from 'three';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
    import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';

    /* -------------------------------------------------------------------------- */
    /* DATA 3 KOMPONEN BAUT (LOREM IPSUM SINGKAT SESUAI REFERENSI CAD)            */
    /* -------------------------------------------------------------------------- */
    const partsData = [
      {
        badge: '01 / 03 // BAUT BAK KALTER CNC',
        title: 'Baut Hex Stars Dual-Key',
        headTag: 'HEX + TORX 6-LOBE',
        desc: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Menggabungkan kepala segi enam luar dengan rongga soket bintang Torx internal serta piringan flange menyatu untuk daya cengkeram maksimal.'
      },
      {
        badge: '02 / 03 // MUR CYLINDER HEAD',
        title: 'Mur Head Ninja 12-Spline',
        headTag: '12-POINT SPLINE CROWN',
        desc: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Desain mahkota 12-point spline tinggi bertingkat dengan alur cincin melingkar di flange bawah serta ulir drat tembus anti-sleek.'
      },
      {
        badge: '03 / 03 // BAUT VISOR & BODI',
        title: 'Baut Visor Payung Bintang 5',
        headTag: 'UMBRELLA 5-STAR CNC',
        desc: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Kepala payung lebar profil rendah dengan ukiran motif bintang 5 timbul, tombol tengah bulat datar, dan 5 alur pisau bubut presisi.'
      }
    ];

    const container = document.getElementById('cad-canvas');
    let scene, camera, renderer, controls;
    let stainlessMat, recessMat;
    let currentIdx = 0;
    const cadGroups = [];
    let isInfoOpen = false;

    /* -------------------------------------------------------------------------- */
    /* HELPER BENTUK 2D CAD UNTUK EKSTRUSI PRESISI                                */
    /* -------------------------------------------------------------------------- */
    function createRegularPolygonShape(radius, sides) {
      const shape = new THREE.Shape();
      for (let i = 0; i < sides; i++) {
        const a = (i / sides) * Math.PI * 2;
        const x = Math.cos(a) * radius;
        const y = Math.sin(a) * radius;
        if (i === 0) shape.moveTo(x, y);
        else shape.lineTo(x, y);
      }
      shape.closePath();
      return shape;
    }

    function createTorxPath(outerRadius, innerRadius, lobes = 6) {
      const path = new THREE.Path();
      const totalPts = lobes * 2;
      for (let i = 0; i < totalPts; i++) {
        const a = (i / totalPts) * Math.PI * 2;
        const r = i % 2 === 0 ? outerRadius : innerRadius;
        const x = Math.cos(a) * r;
        const y = Math.sin(a) * r;
        if (i === 0) path.moveTo(x, y);
        else path.lineTo(x, y);
      }
      path.closePath();
      return path;
    }

    function createCirclePath(radius) {
      const path = new THREE.Path();
      path.absarc(0, 0, radius, 0, Math.PI * 2, false);
      return path;
    }

    function create5StarShape(outerRadius, innerRadius) {
      const shape = new THREE.Shape();
      const totalPts = 10;
      for (let i = 0; i < totalPts; i++) {
        const a = (i / totalPts) * Math.PI * 2 - Math.PI / 2;
        const r = i % 2 === 0 ? outerRadius : innerRadius;
        const x = Math.cos(a) * r;
        const y = Math.sin(a) * r;
        if (i === 0) shape.moveTo(x, y);
        else shape.lineTo(x, y);
      }
      shape.closePath();
      return shape;
    }

    function create12SplineShape(outerRadius, innerRadius, holeRadius = 0) {
      const shape = new THREE.Shape();
      const totalPts = 24;
      for (let i = 0; i < totalPts; i++) {
        const a = (i / totalPts) * Math.PI * 2;
        const r = i % 2 === 0 ? outerRadius : innerRadius;
        const x = Math.cos(a) * r;
        const y = Math.sin(a) * r;
        if (i === 0) shape.moveTo(x, y);
        else shape.lineTo(x, y);
      }
      shape.closePath();
      if (holeRadius > 0) {
        shape.holes.push(createCirclePath(holeRadius));
      }
      return shape;
    }

    /* -------------------------------------------------------------------------- */
    /* MODEL 01: BAUT FLANGE HEX TORX CNC (DUAL-KEY) SESUAI CAD GAMBAR 1          */
    /* -------------------------------------------------------------------------- */
    function buildHexStarsBolt() {
      const group = new THREE.Group();

      // 1. Piringan Flange Bawah CNC
      const flangeGeo = new THREE.CylinderGeometry(1.36, 1.36, 0.16, 64);
      const flangeMesh = new THREE.Mesh(flangeGeo, stainlessMat);
      flangeMesh.position.y = 0.86;
      group.add(flangeMesh);

      const flangeChamferGeo = new THREE.CylinderGeometry(1.16, 1.36, 0.08, 64);
      const flangeChamferMesh = new THREE.Mesh(flangeChamferGeo, stainlessMat);
      flangeChamferMesh.position.y = 0.98;
      group.add(flangeChamferMesh);

      // 2. Kepala Hexagonal Luar dengan Lubang Soket Bintang 6 (Torx Recess) Tembus Asli
      const hexBaseShape = createRegularPolygonShape(1.12, 6);
      const hexBaseGeo = new THREE.ExtrudeGeometry(hexBaseShape, {
        depth: 0.24,
        bevelEnabled: false
      });
      hexBaseGeo.rotateX(Math.PI / 2);
      const hexBaseMesh = new THREE.Mesh(hexBaseGeo, stainlessMat);
      hexBaseMesh.position.y = 1.22;
      group.add(hexBaseMesh);

      const hexTopShape = createRegularPolygonShape(1.12, 6);
      hexTopShape.holes.push(createTorxPath(0.48, 0.32, 6)); // Lubang Torx di Tengah
      const hexTopGeo = new THREE.ExtrudeGeometry(hexTopShape, {
        depth: 0.52,
        bevelEnabled: true,
        bevelThickness: 0.08,
        bevelSize: 0.05,
        bevelSegments: 4
      });
      hexTopGeo.rotateX(Math.PI / 2);
      const hexTopMesh = new THREE.Mesh(hexTopGeo, stainlessMat);
      hexTopMesh.position.y = 1.74;
      group.add(hexTopMesh);

      // Dasar Rongga Kunci Bintang CNC
      const socketFloorGeo = new THREE.CylinderGeometry(0.46, 0.46, 0.08, 24);
      const socketFloorMesh = new THREE.Mesh(socketFloorGeo, recessMat);
      socketFloorMesh.position.y = 1.24;
      group.add(socketFloorMesh);

      // 3. Batang Halus (Smooth Shoulder Shank)
      const shankGeo = new THREE.CylinderGeometry(0.53, 0.53, 1.35, 48);
      const shankMesh = new THREE.Mesh(shankGeo, stainlessMat);
      shankMesh.position.y = 0.15;
      group.add(shankMesh);

      // 4. Batang Inti Drat & Ulir Heliks Presisi
      const coreGeo = new THREE.CylinderGeometry(0.45, 0.43, 2.0, 48);
      const coreMesh = new THREE.Mesh(coreGeo, stainlessMat);
      coreMesh.position.y = -1.25;
      group.add(coreMesh);

      for (let i = 0; i < 17; i++) {
        const ringGeo = new THREE.TorusGeometry(0.495, 0.046, 16, 48);
        const ringMesh = new THREE.Mesh(ringGeo, stainlessMat);
        ringMesh.rotation.x = Math.PI / 2 + 0.055;
        ringMesh.position.y = -0.38 - i * 0.105;
        group.add(ringMesh);
      }

      // 5. Ujung Tirus Chamfer (Lead-in Chamfer)
      const tipGeo = new THREE.CylinderGeometry(0.43, 0.32, 0.18, 48);
      const tipMesh = new THREE.Mesh(tipGeo, stainlessMat);
      tipMesh.position.y = -2.25;
      group.add(tipMesh);

      return group;
    }

    /* -------------------------------------------------------------------------- */
    /* MODEL 02: MUR HEAD CYLINDER 12-SPLINE (NINJA R/RR) SESUAI CAD GAMBAR 3     */
    /* -------------------------------------------------------------------------- */
    function buildHighStarsNut() {
      const group = new THREE.Group();
      const holeRadius = 0.62;

      // 1. Base Flange Bawah dengan Alur Cincin Melingkar
      const flangeLowerGeo = new THREE.CylinderGeometry(1.54, 1.54, 0.14, 64);
      const flangeLowerMesh = new THREE.Mesh(flangeLowerGeo, stainlessMat);
      flangeLowerMesh.position.y = -0.88;
      group.add(flangeLowerMesh);

      const grooveGeo = new THREE.CylinderGeometry(1.44, 1.44, 0.06, 64);
      const grooveMesh = new THREE.Mesh(grooveGeo, recessMat);
      grooveMesh.position.y = -0.78;
      group.add(grooveMesh);

      const flangeUpperGeo = new THREE.CylinderGeometry(1.54, 1.54, 0.14, 64);
      const flangeUpperMesh = new THREE.Mesh(flangeUpperGeo, stainlessMat);
      flangeUpperMesh.position.y = -0.68;
      group.add(flangeUpperMesh);

      const flangeChamferGeo = new THREE.CylinderGeometry(1.28, 1.54, 0.12, 64);
      const flangeChamferMesh = new THREE.Mesh(flangeChamferGeo, stainlessMat);
      flangeChamferMesh.position.y = -0.55;
      group.add(flangeChamferMesh);

      // 2. Badan Utama 12-Point Spline Tinggi (Berlubang Tembus Asli)
      const bodyShape = create12SplineShape(1.26, 1.15, holeRadius);
      const bodyGeo = new THREE.ExtrudeGeometry(bodyShape, {
        depth: 1.15,
        bevelEnabled: false
      });
      bodyGeo.rotateX(Math.PI / 2);
      const bodyMesh = new THREE.Mesh(bodyGeo, stainlessMat);
      bodyMesh.position.y = 0.62;
      group.add(bodyMesh);

      // 3. Leher Chamfer Miring 45 Derajat Menuju Mahkota Atas
      const neckTransitionGeo = new THREE.CylinderGeometry(0.98, 1.25, 0.24, 48);
      const neckTransitionMesh = new THREE.Mesh(neckTransitionGeo, stainlessMat);
      neckTransitionMesh.position.y = 0.74;
      group.add(neckTransitionMesh);

      // 4. Mahkota Atas 12-Point Spline Bertingkat
      const crownShape = create12SplineShape(0.98, 0.90, holeRadius);
      const crownGeo = new THREE.ExtrudeGeometry(crownShape, {
        depth: 0.36,
        bevelEnabled: true,
        bevelThickness: 0.05,
        bevelSize: 0.04,
        bevelSegments: 3
      });
      crownGeo.rotateX(Math.PI / 2);
      const crownMesh = new THREE.Mesh(crownGeo, stainlessMat);
      crownMesh.position.y = 1.15;
      group.add(crownMesh);

      // 5. Lubang Ulir Dalam Tembus (Internal Helical Screw Threads)
      const innerLinerGeo = new THREE.CylinderGeometry(holeRadius, holeRadius, 2.2, 36, 1, true);
      const innerLinerMesh = new THREE.Mesh(innerLinerGeo, recessMat);
      innerLinerMesh.position.y = 0.05;
      group.add(innerLinerMesh);

      for (let i = 0; i < 14; i++) {
        const innerThreadGeo = new THREE.TorusGeometry(holeRadius - 0.02, 0.038, 14, 40);
        const innerThreadMesh = new THREE.Mesh(innerThreadGeo, stainlessMat);
        innerThreadMesh.rotation.x = Math.PI / 2 + 0.04;
        innerThreadMesh.position.y = -0.85 + i * 0.135;
        group.add(innerThreadMesh);
      }

      return group;
    }

    /* -------------------------------------------------------------------------- */
    /* MODEL 03: BAUT VISOR PAYUNG CNC BINTANG 5 SESUAI CAD GAMBAR 2              */
    /* -------------------------------------------------------------------------- */
    function buildVisorStarsBolt() {
      const group = new THREE.Group();

      // 1. Profil Kepala Payung Lebar Pipih (Umbrella / Saucer Head)
      const rimGeo = new THREE.CylinderGeometry(1.75, 1.75, 0.09, 64);
      const rimMesh = new THREE.Mesh(rimGeo, stainlessMat);
      rimMesh.position.y = 0.76;
      group.add(rimMesh);

      const conicalGeo = new THREE.CylinderGeometry(0.85, 1.75, 0.42, 64);
      const conicalMesh = new THREE.Mesh(conicalGeo, stainlessMat);
      conicalMesh.position.y = 1.01;
      group.add(conicalMesh);

      // 2. Motif Pahatan CNC Bintang 5 Timbul di Permukaan Kepala
      const star5Shape = create5StarShape(1.48, 0.58);
      const star5Geo = new THREE.ExtrudeGeometry(star5Shape, {
        depth: 0.14,
        bevelEnabled: true,
        bevelThickness: 0.05,
        bevelSize: 0.04,
        bevelSegments: 3
      });
      star5Geo.rotateX(Math.PI / 2);
      const star5Mesh = new THREE.Mesh(star5Geo, stainlessMat);
      star5Mesh.position.y = 1.26;
      group.add(star5Mesh);

      // Tombol / Kancing Bulat Datar di Tengah Bintang
      const centerButtonGeo = new THREE.CylinderGeometry(0.46, 0.46, 0.16, 48);
      const centerButtonMesh = new THREE.Mesh(centerButtonGeo, stainlessMat);
      centerButtonMesh.position.y = 1.28;
      group.add(centerButtonMesh);

      // 5 Alur Garis CNC (Fluting Grooves) di Setiap Lengan Bintang
      for (let i = 0; i < 5; i++) {
        const a = (i / 5) * Math.PI * 2 - Math.PI / 2;
        const fluteGeo = new THREE.BoxGeometry(0.06, 0.08, 0.95);
        const fluteMesh = new THREE.Mesh(fluteGeo, recessMat);
        fluteMesh.position.set(Math.cos(a) * 0.72, 1.28, Math.sin(a) * 0.72);
        fluteMesh.rotation.y = -a + Math.PI / 2;
        fluteMesh.rotation.x = 0.14;
        group.add(fluteMesh);
      }

      // 3. Leher Kerah Halus (Underhead Neck / Shoulder untuk Karet Damper Visor)
      const neckGeo = new THREE.CylinderGeometry(0.58, 0.58, 0.26, 48);
      const neckMesh = new THREE.Mesh(neckGeo, stainlessMat);
      neckMesh.position.y = 0.59;
      group.add(neckMesh);

      // 4. Batang Inti Drat Pendek (Ukuran M5/M6)
      const coreGeo = new THREE.CylinderGeometry(0.46, 0.43, 1.45, 48);
      const coreMesh = new THREE.Mesh(coreGeo, stainlessMat);
      coreMesh.position.y = -0.25;
      group.add(coreMesh);

      // Cincin Ulir Drat Heliks
      for (let i = 0; i < 13; i++) {
        const ringGeo = new THREE.TorusGeometry(0.495, 0.044, 14, 48);
        const ringMesh = new THREE.Mesh(ringGeo, stainlessMat);
        ringMesh.rotation.x = Math.PI / 2 + 0.055;
        ringMesh.position.y = 0.42 - i * 0.105;
        group.add(ringMesh);
      }

      // Ujung Baut Tirus (Lead Chamfer)
      const tipGeo = new THREE.CylinderGeometry(0.43, 0.32, 0.16, 48);
      const tipMesh = new THREE.Mesh(tipGeo, stainlessMat);
      tipMesh.position.y = -1.02;
      group.add(tipMesh);

      return group;
    }

    /* -------------------------------------------------------------------------- */
    /* INISIALISASI THREE.JS SCENE & INTERAKSI                                    */
    /* -------------------------------------------------------------------------- */
    function init() {
      scene = new THREE.Scene();
      camera = new THREE.PerspectiveCamera(35, container.clientWidth / container.clientHeight, 0.1, 100);
      camera.position.set(0, 0.8, 6.2);

      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(container.clientWidth, container.clientHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.35;
      container.appendChild(renderer.domElement);

      const pmrem = new THREE.PMREMGenerator(renderer);
      scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

      const keyLight = new THREE.DirectionalLight(0xffffff, 2.5);
      keyLight.position.set(5, 8, 6);
      scene.add(keyLight);

      const rimLight = new THREE.DirectionalLight(0xf5b700, 1.0);
      rimLight.position.set(-6, -4, -3);
      scene.add(rimLight);

      // Material PBR Stainless Steel 304 Mengkilap
      stainlessMat = new THREE.MeshStandardMaterial({
        color: 0xe8eef5,
        metalness: 0.94,
        roughness: 0.12
      });

      recessMat = new THREE.MeshStandardMaterial({
        color: 0x1b222c,
        metalness: 0.85,
        roughness: 0.35
      });

      controls = new OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.06;
      controls.enablePan = false;
      controls.minDistance = 3.5;
      controls.maxDistance = 8.5;

      // Masukkan 3 Model Baut CAD
      cadGroups.push(buildHexStarsBolt());
      cadGroups.push(buildHighStarsNut());
      cadGroups.push(buildVisorStarsBolt());

      cadGroups.forEach((grp, idx) => {
        grp.visible = idx === 0;
        grp.rotation.set(0.35, 0.5, -0.15);
        scene.add(grp);
      });

      // Deteksi Klik pada Kanvas 3D (Klik vs Drag)
      let downPt = { x: 0, y: 0 };
      renderer.domElement.addEventListener('pointerdown', e => {
        downPt = { x: e.clientX, y: e.clientY };
      });
      renderer.domElement.addEventListener('pointerup', e => {
        const dist = Math.hypot(e.clientX - downPt.x, e.clientY - downPt.y);
        if (dist < 6) {
          // Klik objek -> Buka/Tutup Animasi Info Text di Kanan!
          toggleInfo();
        }
      });

      window.addEventListener('resize', onWindowResize);
      animate();
    }

    /* -------------------------------------------------------------------------- */
    /* LOGIKA AUTO-ROTATE & RENDER LOOP                                           */
    /* -------------------------------------------------------------------------- */
    function animate() {
      requestAnimationFrame(animate);
      const active = cadGroups[currentIdx];

      if (active) {
        // Otomatis Berputar Halus 360 Derajat Memamerkan Kilap Stainless CNC
        active.rotation.y += 0.012;
        active.rotation.x = THREE.MathUtils.lerp(active.rotation.x, 0.35, 0.05);
        active.rotation.z = THREE.MathUtils.lerp(active.rotation.z, -0.15, 0.05);

        // Jika panel info di kanan terbuka, geser baut sedikit ke kiri agar tidak tertutup teks
        const targetX = isInfoOpen && window.innerWidth >= 768 ? -0.85 : 0;
        active.position.x = THREE.MathUtils.lerp(active.position.x, targetX, 0.08);
      }

      controls.update();
      renderer.render(scene, camera);
    }

    /* -------------------------------------------------------------------------- */
    /* BUKA / TUTUP ANIMASI PANEL INFO DI KANAN                                   */
    /* -------------------------------------------------------------------------- */
    function toggleInfo(forceVal) {
      isInfoOpen = typeof forceVal === 'boolean' ? forceVal : !isInfoOpen;
      const drawer = document.getElementById('info-drawer');

      if (isInfoOpen) {
        drawer.classList.remove('translate-x-[120%]', 'opacity-0', 'pointer-events-none');
        drawer.classList.add('translate-x-0', 'opacity-100');
      } else {
        drawer.classList.add('translate-x-[120%]', 'opacity-0', 'pointer-events-none');
        drawer.classList.remove('translate-x-0', 'opacity-100');
      }
    }

    /* -------------------------------------------------------------------------- */
    /* GANTI KOMPONEN BAUT (TOMBOL KANAN / KIRI)                                  */
    /* -------------------------------------------------------------------------- */
    function changePart(dir) {
      currentIdx = (currentIdx + dir + cadGroups.length) % cadGroups.length;
      cadGroups.forEach((g, i) => { g.visible = i === currentIdx; });

      const data = partsData[currentIdx];
      document.getElementById('panel-badge').textContent = data.badge;
      document.getElementById('panel-title').textContent = data.title;
      document.getElementById('panel-head-tag').textContent = data.headTag;
      document.getElementById('panel-desc').textContent = data.desc;

      // Update Nav Dots
      const dotsContainer = document.getElementById('nav-dots');
      dotsContainer.innerHTML = partsData.map((_, i) => `
        <div class="${i === currentIdx ? 'w-6 bg-industrial-yellow' : 'w-2 bg-carbon-700'} h-1.5 rounded-full transition-all"></div>
      `).join('');
    }

    // Event Listeners Tombol Kiri & Kanan
    document.getElementById('btn-prev').addEventListener('click', (e) => {
      e.stopPropagation();
      changePart(-1);
    });
    document.getElementById('btn-next').addEventListener('click', (e) => {
      e.stopPropagation();
      changePart(1);
    });

    // Close Info Panel Buttons
    document.getElementById('btn-close-info').addEventListener('click', (e) => {
      e.stopPropagation();
      toggleInfo(false);
    });
    document.getElementById('btn-hide-info-bottom').addEventListener('click', (e) => {
      e.stopPropagation();
      toggleInfo(false);
    });

    function onWindowResize() {
      if (!container || !renderer) return;
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    }

    init();
  </script>
</body>
</html>
